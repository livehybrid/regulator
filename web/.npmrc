# Splunk's front-end packages are published against yarn's looser peer
# resolution: @splunk/eslint-config v5 and its airbnb/react plugin set declare
# peer ranges that npm 7+ refuses outright. Setting this here rather than
# relying on everyone remembering the flag is what keeps `npm ci` in CI and
# `npm install` on a laptop producing the same tree.
legacy-peer-deps=true
