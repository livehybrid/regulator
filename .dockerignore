# Anything here would be copied into the build context and, for the console's
# node_modules, would overwrite the ones `npm ci` just installed for the right
# platform. Keeping them out is what makes the image reproducible rather than
# a copy of whatever happened to be on the machine that built it.
**/node_modules
**/.venv
**/__pycache__
**/*.pyc
.git
.github
.pytest_cache
*.egg-info

# Generated by the UI build inside the image; a local copy must not shadow it.
server/ui

# Local state and results: never wanted in an image, and often large.
*.db
*.sqlite
data/
results/
*.parquet
site/
dist/
build/

# Secrets, in case a checkout has any.
.env
*.key
*.pem
secrets/
infra/k8s/secret.yaml
