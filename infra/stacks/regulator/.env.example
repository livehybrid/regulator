# Regulator control-plane deploy config. Copy to a file named .env in this
# directory (git-ignored) and fill it in. deploy.py reads that file (and the
# process env) and injects these into the swarm stack via the Portainer API.

# --- Portainer (required) ---
PORTAINER_HOST=             # Portainer host, e.g. 192.0.2.10 or portainer.example.com
PORTAINER_TOKEN=            # Portainer API key (X-API-Key)
PORTAINER_ENDPOINT=6        # the id of YOUR Portainer environment, from its URL
# REGULATOR_SWARM_ID=       # the swarm id (deploy.py discovers it when unset)

# --- The control plane itself (required) ---
REG_ADMIN_PASSWORD=         # the one operator password. Unset is refused.
# REG_API_TOKENS=           # comma-separated bearer tokens for CI, 16+ chars each

# --- Placement and exposure ---
REGULATOR_NODE=hpelite      # the swarm node the data volume lives on
REGULATOR_PORT=8092         # LAN port
REGULATOR_HOST=regulator.mydomain.com   # the Traefik Host rule
# REGULATOR_IMAGE=ghcr.io/livehybrid/regulator:latest

# --- Telemetry: where runs launched from the web interface ship results ---
# Both or neither. Point it at a Splunk that is NOT the one under test unless
# you mean to self-instrument; the run record says which.
REG_HEC_URL=
REG_HEC_TOKEN=
REG_HEC_INDEX=regulator
REG_HEC_VERIFY_TLS=0
# One sample of the run's time series every N seconds (the charts and regulator:sample).
REG_SAMPLE_INTERVAL_S=5

# --- A target registered at boot (optional) ---
# REG_SEED_TARGET_NAME=lab
# REG_SEED_TARGET_URL=https://splunk.example:8089
# REG_SEED_TARGET_WEB_URL=https://splunk.example:8000
# REG_SEED_TARGET_TOKEN=
# REG_SEED_TARGET_USERNAME=
# REG_SEED_TARGET_PASSWORD=
# REG_SEED_TARGET_VERIFY_TLS=0

# --- Configuration restored at boot (optional) ---
# The JSON the Configuration page downloads: your targets and your own
# scenarios. Either a path to a file mounted into the container, or the JSON
# itself. It needs the SAME REG_MASTER_KEY as the instance it came from, or the
# credentials in it cannot be decrypted (the restore says so rather than
# leaving every target quietly unable to authenticate).
# REG_CONFIG_IMPORT=/data/regulator-config.json

# --- A target behind a private CA (optional) ---
# A PEM bundle that verifies the customer's certificate where the public trust
# store will not. Used only where the target's own verify_tls is ON, so it
# composes with that switch; without it the only setting that works against a
# private CA is verify_tls off, which ships a splunkd credential over a
# connection nothing checked. A path that does not exist is a fatal boot error
# on purpose. Projected to fleet workers automatically, so mount it here only.
# REG_CA_BUNDLE=/etc/regulator/ca/customer-root-ca.pem

# --- A shared scenario library (optional) ---
# One .tar.gz per scenario, in the same format the console's Download and
# Upload speak. Pulled at boot, create-if-absent, so a local edit survives a
# restart. Credentials for an s3:// source come from the usual boto3 chain.
# REG_SCENARIO_SOURCE=s3://my-bucket/regulator-scenarios
# Also PUSH scenarios created here back to that prefix. A separate switch on
# purpose: the common case is a curated library several instances read, and one
# of them silently overwriting it would be hard to notice.
# REG_SCENARIO_SOURCE_WRITE=1

# --- A shared config copy and run history (optional) ---
# Targets, your scenarios and baselines in regulator-config.json, and each
# finished run in runs/<uid>.json. Pulled at boot, so a rebuilt instance comes
# back configured and with the baselines its CI gate compares against. Needs
# the same REG_MASTER_KEY as the instance that pushed it.
# REG_CONFIG_SOURCE=s3://my-bucket/regulator-config
# Also PUSH every change and every finished run. One writer per copy.
# REG_CONFIG_SOURCE_WRITE=1
# For a bucket policy that denies PutObject without encryption headers.
# REG_CONFIG_SOURCE_SSE=aws:kms
# REG_CONFIG_SOURCE_SSE_KMS_KEY_ID=arn:aws:kms:eu-west-2:111122223333:key/...
# AWS_REGION=eu-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- The swarm fleet ---
# Workers launch as swarm services through the same Portainer API key; the
# default fleet becomes swarm so a run from the web interface uses them. Keep
# workers off the node that runs the Splunk under test.
REG_DEFAULT_FLEET=swarm
REG_SWARM_CONSTRAINTS=node.hostname != macdev
# REG_VUS_PER_WORKER=200
# REG_PUBLIC_BASE_URL=http://regulator:8080

# --- Ceilings ---
# REG_MAX_VIRTUAL_USERS=300
# REG_MAX_CONCURRENT_RUNS=1
# REG_MAX_RUN_DURATION_S=14400
# Total time a run may stay paused before it is stopped rather than resumed.
# REG_MAX_PAUSE_S=1800

# --- Master key (managed automatically) ---
# Leave unset on first deploy: deploy.py generates a Fernet key, appends it to
# the .env file and creates the `regulator_master_key` swarm secret from it. It
# encrypts every stored target credential; lose it and they are unrecoverable.
# REG_MASTER_KEY=
