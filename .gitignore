# Python
__pycache__/
*.pyc
.venv/
.venv-*/
venv/
.pytest_cache/
*.egg-info/
.coverage
.coverage.*
htmlcov/
dist/
build/

# Node
node_modules/
ui/dist/

# The operator console is compiled from web/ into server/ui by `make ui`, and
# the whole of server/ui is generated: an index.html naming a content-hashed
# bundle, and the bundle itself. Committing a 1.5 MB minified artefact would
# conflict on every branch and tell a reviewer nothing, so it is built rather
# than tracked. The Docker image builds it in its own stage; running from a
# checkout needs `make ui` once (the server says so if it is missing).
server/ui/

# Docs build output
site/

# Deployment secrets. The example files are tracked; the real ones never are.
infra/k8s/secret.yaml
infra/stacks/*/.env
*.key
*.pem
secrets/

# Secrets and local state. The control plane keeps a Fernet key and a SQLite
# file next to the code when run from a checkout, so both are excluded rather
# than relying on anyone remembering at `git add` time.
.env
*.db
*.sqlite
data/

# Local run artefacts. A Regulator run writes per-search latency samples, and
# those are large, machine-specific and reproducible: they belong in object
# storage or a report, never in the repository.
results/
*.parquet

# Editor and OS noise
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
